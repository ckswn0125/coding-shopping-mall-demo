PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/shoping-mall
NODE_ENV=development

# Atlas 주소 (값이 있으면 Atlas, 비어 있으면 로컬 MONGODB_URI 사용)
MONGODB_URL_ATLAS_URL=

# JWT 토큰 서명용 비밀키 (외부에 노출되면 안 됨)
JWT_SECRET=shoping-mall-dev-secret-change-me

# 토큰 만료 시간 (7d = 7일, 1h = 1시간)
JWT_EXPIRES_IN=7d

# 포트원(아임포트) REST API 키 — 관리자 콘솔 > 내 식별코드/API Keys
# 없으면 개발 모드에서만 클라이언트 결제 성공을 신뢰합니다.
PORTONE_API_KEY=
PORTONE_API_SECRET=
